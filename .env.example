# =============================================================================
# worm-ai — root environment template
# Copy to .env and fill in. Never commit real secrets.
# © 3MH Technologies — https://3mh.pages.dev/ — https://t.me/j49_c
# =============================================================================

# ---- Core ----
NODE_ENV=development
ENV=development
APP_NAME=worm-ai
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ---- MongoDB Atlas ----
# Get from https://cloud.mongodb.com → Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=wormgpt

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-64-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAY=14
CSRF_SECRET=replace-me-too-64-chars-min
COOKIE_SECURE=false

# ---- Encryption (for API keys) ----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---- NoTrack AI (sole LLM backend) ----
# Dispatch client: https://github.com/3MH-Technologies/notrack
# Optional: paste your browser cookie string for higher limits: "k1=v1; k2=v2"
NOTRACK_BASE=https://notrack.ai
NOTRACK_COOKIE=
# A=Worm Flash  B=Worm Pro  C=Worm Core (default)  F=Worm Synth
NOTRACK_MODEL=C
# normal | creative | precise | concise | socratic | tutor | coder
NOTRACK_PERSONA=normal
NOTRACK_MAX_TURNS=6

# ---- Worm Agent (coding agent via 3MH Technologies DeepSeek proxy) ----
# Docs: https://deepseek-pow.contact-3mh.workers.dev
# Get a token from chat.deepseek.com (Authorization header) or POST /api/login
DEEPSEEK_PROXY_BASE=https://deepseek-pow.contact-3mh.workers.dev
DEEPSEEK_TOKEN=
DEEPSEEK_MODEL=deepseek-chat
AGENT_MAX_ITERATIONS=8

# ---- Web Search ----
# Provider for /api/web/search. Defaults to a built-in DuckDuckGo scraper.
WEB_SEARCH_PROVIDER=duckduckgo
SERPER_API_KEY=
TAVILY_API_KEY=

# ---- Limits ----
RATE_LIMIT_PER_MIN=120
MAX_UPLOAD_MB=20
MAX_CONTEXT_TOKENS=32000

# ---- Observability ----
LOG_LEVEL=INFO
SENTRY_DSN=

# ---- Bootstrap ----
# First super admin — created only if the users collection is empty (fresh install).
# Existing accounts are never modified on restart.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
BOOTSTRAP_ADMIN_USERNAME=admin
